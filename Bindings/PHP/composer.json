    "authors": [
        {"name": "pka_human", "email": "pka_human@proton.me"}
    ],
    "support": {
        "issues": "https://github.com/pka-human/Spingalett/issues",
        "source": "https://github.com/pka-human/Spingalett/tree/main/Bindings/PHP"
    },
    "require": {
        "php": ">=7.4",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "Spingalett\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    }
