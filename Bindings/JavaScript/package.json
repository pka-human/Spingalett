{
  "name": "spingalett",
  "version": "1.4.0",
  "description": "Spingalett's inference engine in WebAssembly: .slett models from FP32 to INT2, transformers and text generation, in Node and browsers",
  "keywords": [
    "neural networks",
    "inference",
    "webassembly",
    "wasm",
    "quantization",
    "transformer",
    "language model"
  ],
  "homepage": "https://github.com/pka-human/Spingalett/tree/main/Bindings/JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pka-human/Spingalett.git",
    "directory": "Bindings/JavaScript"
  },
  "license": "MIT",
  "author": "pka_human <pka_human@proton.me>",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./spingalett.wasm": "./spingalett.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "spingalett.wasm",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "sh build.sh",
    "test": "node --test test/engine.test.mjs test/native.test.mjs",
    "prepack": "sh build.sh && cp ../../LICENSE LICENSE"
  }
}
