IR_OP(Pad, k_pad)
IR_OP(Shape, k_shape)
IR_OP(Size, k_size)
IR_OP(Range, k_range)
IR_OP(ConstantOfShape, k_constant_of_shape)
IR_OP(Constant, k_constant)
IR_OP(Trilu, k_trilu)
IR_OP(Resize, k_resize)
IR_OP(Upsample, k_resize)
IR_OP(DepthToSpace, k_depth_space)
IR_OP(SpaceToDepth, k_depth_space)
IR_OP(NonZero, k_nonzero)
IR_OP(OneHot, k_onehot)
IR_OP(EyeLike, k_eye_like)
