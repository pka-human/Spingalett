/* The operators of graphs (Spingalett.IR.h) and their kernels (Spingalett.IROps.c), ONNX's names: IR_OP(name, kernel).
   The order is the opcodes' of `.slett` format 11's files: new operators go at the end. */

/* element-wise, with broadcasting */
IR_OP(Add, k_binary)
IR_OP(Sub, k_binary)
IR_OP(Mul, k_binary)
IR_OP(Div, k_binary)
IR_OP(Pow, k_binary)
IR_OP(Mod, k_binary)
IR_OP(Max, k_variadic)
IR_OP(Min, k_variadic)
IR_OP(Sum, k_variadic)
IR_OP(Mean, k_variadic)
IR_OP(Equal, k_compare)
IR_OP(Less, k_compare)
IR_OP(LessOrEqual, k_compare)
IR_OP(Greater, k_compare)
IR_OP(GreaterOrEqual, k_compare)
IR_OP(And, k_logic)
IR_OP(Or, k_logic)
IR_OP(Xor, k_logic)
IR_OP(PRelu, k_binary)
IR_OP(Where, k_where)
IR_OP(Abs, k_unary)
IR_OP(Neg, k_unary)
IR_OP(Exp, k_unary)
IR_OP(Log, k_unary)
IR_OP(Sqrt, k_unary)
IR_OP(Reciprocal, k_unary)
IR_OP(Sin, k_unary)
IR_OP(Cos, k_unary)
IR_OP(Tanh, k_unary)
IR_OP(Sigmoid, k_unary)
IR_OP(Erf, k_unary)
IR_OP(Relu, k_unary)
IR_OP(LeakyRelu, k_unary)
IR_OP(Elu, k_unary)
IR_OP(Selu, k_unary)
IR_OP(Gelu, k_unary)
IR_OP(HardSigmoid, k_unary)
IR_OP(HardSwish, k_unary)
IR_OP(Softplus, k_unary)
IR_OP(Softsign, k_unary)
IR_OP(Mish, k_unary)
IR_OP(Floor, k_unary)
IR_OP(Ceil, k_unary)
IR_OP(Round, k_unary)
IR_OP(Sign, k_unary)
IR_OP(Not, k_unary)
IR_OP(IsNaN, k_unary)
IR_OP(IsInf, k_unary)
IR_OP(Tan, k_unary)
IR_OP(Asin, k_unary)
IR_OP(Acos, k_unary)
IR_OP(Atan, k_unary)
IR_OP(Sinh, k_unary)
IR_OP(Cosh, k_unary)
IR_OP(Asinh, k_unary)
IR_OP(Acosh, k_unary)
IR_OP(Atanh, k_unary)
IR_OP(Celu, k_unary)
IR_OP(ThresholdedRelu, k_unary)
IR_OP(Shrink, k_unary)
IR_OP(Swish, k_unary)
IR_OP(BitwiseNot, k_unary)
IR_OP(BitwiseAnd, k_bitwise)
IR_OP(BitwiseOr, k_bitwise)
IR_OP(BitwiseXor, k_bitwise)
IR_OP(BitShift, k_bitwise)
IR_OP(SwiGLU, k_swiglu)
IR_OP(Clip, k_clip)
IR_OP(Cast, k_cast)
IR_OP(CastLike, k_cast)
IR_OP(Identity, k_identity)
IR_OP(Dropout, k_identity)
/* products and convolutions */
IR_OP(MatMul, k_matmul)
IR_OP(Gemm, k_gemm)
IR_OP(Conv, k_conv)
IR_OP(ConvTranspose, k_conv_transpose)
