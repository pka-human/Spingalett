IR_OP(AveragePool, k_pool)
IR_OP(LpPool, k_pool)
IR_OP(GlobalAveragePool, k_global_pool)
IR_OP(GlobalMaxPool, k_global_pool)
/* normalizations */
IR_OP(BatchNormalization, k_batch_norm)
IR_OP(InstanceNormalization, k_group_norm)
IR_OP(LayerNormalization, k_layer_norm)
IR_OP(GroupNormalization, k_group_norm)
