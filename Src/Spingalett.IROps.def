IR_OP(ReduceSum, k_reduce)
IR_OP(ReduceMean, k_reduce)
IR_OP(ReduceMax, k_reduce)
IR_OP(ReduceMin, k_reduce)
IR_OP(ReduceProd, k_reduce)
IR_OP(ReduceSumSquare, k_reduce)
IR_OP(ReduceL1, k_reduce)
IR_OP(ReduceL2, k_reduce)
IR_OP(ReduceLogSumExp, k_reduce)
IR_OP(ReduceLogSum, k_reduce)
