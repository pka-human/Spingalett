/* quantization */
IR_OP(QuantizeLinear, k_quantize)
IR_OP(DequantizeLinear, k_dequantize)
IR_OP(DynamicQuantizeLinear, k_dynamic_quantize)
IR_OP(MatMulInteger, k_matmul_integer)
IR_OP(QLinearMatMul, k_matmul_integer)
/* composite operators (ONNX opset 23's, with a reference decomposition) */
IR_OP(Attention, k_attention)
IR_OP(RotaryEmbedding, k_rotary)
IR_OP(LinearAttention, k_linear_attention)
IR_OP(CausalConvWithState, k_causal_conv)
/* the library's own operators, which fusions make (Spingalett.IRFuse.c) */
IR_OP(Linear, k_linear)
IR_OP(FusedAttention, k_fused_attention)
