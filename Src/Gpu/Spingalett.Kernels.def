/* The GPU kernels: SPG_KERNEL(name) is Shaders/name.comp, compiled to SPIR-V and embedded by
   cmake/Vulkan.cmake. SPG_KERNEL_H(name) is compiled twice: as name, and with SPG_HALF defined as
   name_h, the variant that may keep activations as bfloat16 (16-bit storage, which only devices with
   bfloat16 matrix units are asked for). */

SPG_KERNEL(gemm)
SPG_KERNEL(gemm_mma)
SPG_KERNEL_H(colsum)
SPG_KERNEL(reduce)
SPG_KERNEL_H(bn)
SPG_KERNEL_H(eltwise)
SPG_KERNEL(output)
SPG_KERNEL_H(pool)
SPG_KERNEL_H(combine)
SPG_KERNEL(wtrans)
SPG_KERNEL_H(optim)
SPG_KERNEL(sumsq)
SPG_KERNEL_H(upsample)
SPG_KERNEL_H(ln)
SPG_KERNEL_H(rows)
SPG_KERNEL_H(dwconv)
SPG_KERNEL_H(embed)
SPG_KERNEL_H(attn)
