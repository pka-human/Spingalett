/* The units of PTX of the CUDA backend: SPG_CUDA_UNIT(name, source, "defines") is Src/Gpu/Cuda/<source>.cu
   compiled by cmake/Cuda.cmake with -DSPG_ENTRY=spg_<name> and the defines, a module of its own whose
   kernel is spg_<name>, given to the driver (and compiled by it) when first dispatched. The units of the
   matrix product are the tiles times the modes below: gemm_<BM>x<BN>x<BK>_<TM>x<TN>_a<A>b<B>, followed by v
   with VEC, compiled with -DGEMM=BM,BN,BK,TM,TN,A,B,VEC. */

SPG_CUDA_UNIT(reduce, reduce, "")
SPG_CUDA_UNIT(colsum, colsum, "")
SPG_CUDA_UNIT(bn, bn, "")
SPG_CUDA_UNIT(eltwise, eltwise, "")
SPG_CUDA_UNIT(output, output, "")
SPG_CUDA_UNIT(pool, pool, "")
SPG_CUDA_UNIT(combine, combine, "")
SPG_CUDA_UNIT(wtrans, wtrans, "")
SPG_CUDA_UNIT(optim, optim, "")
SPG_CUDA_UNIT(sumsq, sumsq, "")
SPG_CUDA_UNIT(upsample, upsample, "")
SPG_CUDA_UNIT(ln, ln, "")
SPG_CUDA_UNIT(rows, rows, "")
SPG_CUDA_UNIT(epi, epi, "")         /* the products' epilogues that gemm.cu and gemm_mma.cu do not hold */
SPG_CUDA_UNIT(dconv9, dconv, "-DKMAX=9 -DEXACT=1")     /* products of few k over convolutions' windows: k of */
SPG_CUDA_UNIT(dconv16, dconv, "-DKMAX=16")              /* KMAX (EXACT), or up to it */
SPG_CUDA_UNIT(dconv27, dconv, "-DKMAX=27 -DEXACT=1")
SPG_CUDA_UNIT(dconv32, dconv, "-DKMAX=32")
SPG_CUDA_UNIT(dconv48, dconv, "-DKMAX=48")
SPG_CUDA_UNIT(embed, embed, "")
SPG_CUDA_UNIT(attn_cache, attn_cache, "")   /* attention over a cache of keys and values (decoding) */
SPG_CUDA_UNIT(gew, gew, "")                 /* the element-wise operators of graphs */
SPG_CUDA_UNIT(gcopy, gcopy, "")             /* their copies through strides */
SPG_CUDA_UNIT(gcvt, gcvt, "")               /* the same of floats rounded to bfloat16 */
SPG_CUDA_UNIT(ggather, ggather, "")         /* Gather */
SPG_CUDA_UNIT(grow, grow, "")               /* reductions, softmax and normalizations over rows */
SPG_CUDA_UNIT(gattn_d32, gattn, "-DD=32u")  /* FusedAttention: heads of up to 32, 64, 128 values */
SPG_CUDA_UNIT(gattn_d64, gattn, "-DD=64u")
SPG_CUDA_UNIT(gattn_d128, gattn, "-DD=128u")
SPG_CUDA_UNIT(gflash_d32, gflash, "-DD=32u")    /* and on the matrix units, in bfloat16 */
SPG_CUDA_UNIT(gflash_d64, gflash, "-DD=64u")
SPG_CUDA_UNIT(gflash_d128, gflash, "-DD=128u")
SPG_CUDA_UNIT(gflash_d32_m1, gflash, "-DD=32u -DMTS=1u")
SPG_CUDA_UNIT(gflash_d64_m1, gflash, "-DD=64u -DMTS=1u")
SPG_CUDA_UNIT(gpool, gpool, "")             /* MaxPool, AveragePool and LpPool */
SPG_CUDA_UNIT(gresize, gresize, "")         /* Resize */
SPG_CUDA_UNIT(iquant, iquant, "")           /* integer models: their activations quantized, */
SPG_CUDA_UNIT(ipass, ipass, "")             /* their other passes */
/* integer models' linear layers in sessions: products of a few rows with their codes widened in registers, a unit of
   BITS and ROWS each (wqmv_b<BITS>_r<ROWS>) */
SPG_CUDA_UNIT(wqmv_b8_r1, wqmv, "-DBITS=8u -DROWS=1u")
SPG_CUDA_UNIT(wqmv_b8_r2, wqmv, "-DBITS=8u -DROWS=2u")
SPG_CUDA_UNIT(wqmv_b8_r4, wqmv, "-DBITS=8u -DROWS=4u")
SPG_CUDA_UNIT(wqmv_b8_r8, wqmv, "-DBITS=8u -DROWS=8u")
SPG_CUDA_UNIT(wqmv_b4_r1, wqmv, "-DBITS=4u -DROWS=1u")
SPG_CUDA_UNIT(wqmv_b4_r2, wqmv, "-DBITS=4u -DROWS=2u")
SPG_CUDA_UNIT(wqmv_b4_r4, wqmv, "-DBITS=4u -DROWS=4u")
SPG_CUDA_UNIT(wqmv_b4_r8, wqmv, "-DBITS=4u -DROWS=8u")
SPG_CUDA_UNIT(wqmv_b2_r1, wqmv, "-DBITS=2u -DROWS=1u")
SPG_CUDA_UNIT(wqmv_b2_r2, wqmv, "-DBITS=2u -DROWS=2u")
SPG_CUDA_UNIT(wqmv_b2_r4, wqmv, "-DBITS=2u -DROWS=4u")
SPG_CUDA_UNIT(wqmv_b2_r8, wqmv, "-DBITS=2u -DROWS=8u")
/* language models' layers of block precisions (GGUF's types) in sessions: their inputs quantized in blocks, then
   products of a few rows with the blocks as stored, the CPU's bits: a unit a type and ROWS (bdot_<type>_r<ROWS>) */
SPG_CUDA_UNIT(bquant, bquant, "")
/* (RMS normalizations with the sums before them and the quantizations after them, a unit the values a thread at most) */
SPG_CUDA_UNIT(bnorm_v8, bnorm, "-DVMAX=8u")
SPG_CUDA_UNIT(bnorm_v16, bnorm, "-DVMAX=16u")
SPG_CUDA_UNIT(bnorm_v32, bnorm, "-DVMAX=32u")
/* (a prompt's many rows on the matrix units, a unit a type: bmm_<type>) */
SPG_CUDA_UNIT(bmmp_q8_0, bmmp, "-DTYPE=0u")
SPG_CUDA_UNIT(bmmp_q4_k, bmmk, "-DTYPE=7u")
SPG_CUDA_UNIT(bmmp_q6_k, bmmk, "-DTYPE=9u")
SPG_CUDA_UNIT(bmmp_q4_0, bmmn, "-DTYPE=1u")
SPG_CUDA_UNIT(bmmp_q4_1, bmmn, "-DTYPE=2u")
SPG_CUDA_UNIT(bmmp_q5_0, bmmn, "-DTYPE=3u")
SPG_CUDA_UNIT(bmmp_q5_1, bmmn, "-DTYPE=4u")
SPG_CUDA_UNIT(bmmp_iq4_nl, bmmn, "-DTYPE=10u")
/* (a row of the packed weights: bdotp_<type>) */
SPG_CUDA_UNIT(bdotp_q8_0, bdotp, "-DTYPE=0u")
SPG_CUDA_UNIT(bdotp_q4_k, bdotk, "-DTYPE=7u")
SPG_CUDA_UNIT(bdotp_q6_k, bdotk, "-DTYPE=9u")
SPG_CUDA_UNIT(bdotp_q4_0, bdotn, "-DTYPE=1u")
SPG_CUDA_UNIT(bdotp_q4_1, bdotn, "-DTYPE=2u")
SPG_CUDA_UNIT(bdotp_q5_0, bdotn, "-DTYPE=3u")
SPG_CUDA_UNIT(bdotp_q5_1, bdotn, "-DTYPE=4u")
SPG_CUDA_UNIT(bdotp_iq4_nl, bdotn, "-DTYPE=10u")
SPG_CUDA_UNIT(bmm_q8_0, bmm, "-DTYPE=0u")
SPG_CUDA_UNIT(bmm_q4_0, bmm, "-DTYPE=1u")
SPG_CUDA_UNIT(bmm_q4_1, bmm, "-DTYPE=2u")
SPG_CUDA_UNIT(bmm_q5_0, bmm, "-DTYPE=3u")
SPG_CUDA_UNIT(bmm_q5_1, bmm, "-DTYPE=4u")
SPG_CUDA_UNIT(bmm_q2_k, bmm, "-DTYPE=5u")
SPG_CUDA_UNIT(bmm_q3_k, bmm, "-DTYPE=6u")
SPG_CUDA_UNIT(bmm_q4_k, bmm, "-DTYPE=7u")
SPG_CUDA_UNIT(bmm_q5_k, bmm, "-DTYPE=8u")
SPG_CUDA_UNIT(bmm_q6_k, bmm, "-DTYPE=9u")
SPG_CUDA_UNIT(bmm_iq4_nl, bmm, "-DTYPE=10u")
SPG_CUDA_UNIT(bmm_iq4_xs, bmm, "-DTYPE=11u")
SPG_CUDA_UNIT(bembed, bembed, "")           /* and the rest of a session's step: embeddings, attention */
SPG_CUDA_UNIT(kvattn, kvattn, "")
SPG_CUDA_UNIT(bdot_q8_0_r1, bdot, "-DTYPE=0u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q8_0_r8, bdot, "-DTYPE=0u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q4_0_r1, bdot, "-DTYPE=1u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q4_0_r8, bdot, "-DTYPE=1u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q4_1_r1, bdot, "-DTYPE=2u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q4_1_r8, bdot, "-DTYPE=2u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q5_0_r1, bdot, "-DTYPE=3u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q5_0_r8, bdot, "-DTYPE=3u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q5_1_r1, bdot, "-DTYPE=4u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q5_1_r8, bdot, "-DTYPE=4u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q2_k_r1, bdot, "-DTYPE=5u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q2_k_r8, bdot, "-DTYPE=5u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q3_k_r1, bdot, "-DTYPE=6u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q3_k_r8, bdot, "-DTYPE=6u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q4_k_r1, bdot, "-DTYPE=7u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q4_k_r8, bdot, "-DTYPE=7u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q5_k_r1, bdot, "-DTYPE=8u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q5_k_r8, bdot, "-DTYPE=8u -DROWS=8u")
SPG_CUDA_UNIT(bdot_q6_k_r1, bdot, "-DTYPE=9u -DROWS=1u")
SPG_CUDA_UNIT(bdot_q6_k_r8, bdot, "-DTYPE=9u -DROWS=8u")
SPG_CUDA_UNIT(bdot_iq4_nl_r1, bdot, "-DTYPE=10u -DROWS=1u")
SPG_CUDA_UNIT(bdot_iq4_nl_r8, bdot, "-DTYPE=10u -DROWS=8u")
SPG_CUDA_UNIT(bdot_iq4_xs_r1, bdot, "-DTYPE=11u -DROWS=1u")
SPG_CUDA_UNIT(bdot_iq4_xs_r8, bdot, "-DTYPE=11u -DROWS=8u")
SPG_CUDA_UNIT(attn_d256, attn, "-DDMAX=256u")     /* attention in single precision: heads of up to 256, */
SPG_CUDA_UNIT(rattn_d32_o0, rattn, "-DD=32u -DOPC=0u")   /* of up to 32, 64, 128 a unit per pass */
SPG_CUDA_UNIT(rattn_d32_o1, rattn, "-DD=32u -DOPC=1u")
SPG_CUDA_UNIT(rattn_d32_o2, rattn, "-DD=32u -DOPC=2u")
SPG_CUDA_UNIT(rattn_d32_o3, rattn, "-DD=32u -DOPC=3u")
SPG_CUDA_UNIT(rattn_d64_o0, rattn, "-DD=64u -DOPC=0u")
SPG_CUDA_UNIT(rattn_d64_o1, rattn, "-DD=64u -DOPC=1u")
SPG_CUDA_UNIT(rattn_d64_o2, rattn, "-DD=64u -DOPC=2u")
SPG_CUDA_UNIT(rattn_d64_o3, rattn, "-DD=64u -DOPC=3u")
SPG_CUDA_UNIT(rattn_d128_o0, rattn, "-DD=128u -DOPC=0u")
SPG_CUDA_UNIT(rattn_d128_o1, rattn, "-DD=128u -DOPC=1u")
SPG_CUDA_UNIT(rattn_d128_o2, rattn, "-DD=128u -DOPC=2u")
SPG_CUDA_UNIT(rattn_d128_o3, rattn, "-DD=128u -DOPC=3u")
/* the same for layers with padding (EXT, SPG_ATTN_EXT): the units above stay those of layers without */
SPG_CUDA_UNIT(attn_d256x, attn, "-DDMAX=256u -DEXT=1")
SPG_CUDA_UNIT(rattn_d32_o0x, rattn, "-DD=32u -DOPC=0u -DEXT=1")
SPG_CUDA_UNIT(rattn_d32_o2x, rattn, "-DD=32u -DOPC=2u -DEXT=1")
SPG_CUDA_UNIT(rattn_d32_o3x, rattn, "-DD=32u -DOPC=3u -DEXT=1")
SPG_CUDA_UNIT(rattn_d64_o0x, rattn, "-DD=64u -DOPC=0u -DEXT=1")
SPG_CUDA_UNIT(rattn_d64_o2x, rattn, "-DD=64u -DOPC=2u -DEXT=1")
SPG_CUDA_UNIT(rattn_d64_o3x, rattn, "-DD=64u -DOPC=3u -DEXT=1")
SPG_CUDA_UNIT(rattn_d128_o0x, rattn, "-DD=128u -DOPC=0u -DEXT=1")
SPG_CUDA_UNIT(rattn_d128_o2x, rattn, "-DD=128u -DOPC=2u -DEXT=1")
SPG_CUDA_UNIT(rattn_d128_o3x, rattn, "-DD=128u -DOPC=3u -DEXT=1")
/* attention on the matrix units (networks in bfloat16): a unit per head size and pass (0 FORWARD, 2 DQ, 3 DKV) */
SPG_CUDA_UNIT(flash_d32_o0, flash, "-DD=32u -DOPC=0u")
SPG_CUDA_UNIT(flash_d32_o2, flash, "-DD=32u -DOPC=2u")
SPG_CUDA_UNIT(flash_d32_o3, flash, "-DD=32u -DOPC=3u")
SPG_CUDA_UNIT(flash_d64_o0, flash, "-DD=64u -DOPC=0u")
SPG_CUDA_UNIT(flash_d64_o2, flash, "-DD=64u -DOPC=2u")
SPG_CUDA_UNIT(flash_d64_o3, flash, "-DD=64u -DOPC=3u")
SPG_CUDA_UNIT(flash_d128_o0, flash, "-DD=128u -DOPC=0u")
SPG_CUDA_UNIT(flash_d128_o2, flash, "-DD=128u -DOPC=2u")
SPG_CUDA_UNIT(flash_d128_o3, flash, "-DD=128u -DOPC=3u")

/* depthwise convolutions: any window, stride, mode, VEC and padding, and the common windows (KH, KW, SH, SW),
   padded (KW - 1) / 2, for every mode (0 APPLY, 1 SPREAD, 2 WEIGHTS) and VEC (1, 4) as constants: units
   dwconv_k<KH><KW>s<SH><SW>_m<MODE>v<VEC> */
SPG_CUDA_UNIT(dwconv, dwconv, "-DWINDOW=0,0,0,0,ANY,ANY,ANY")
SPG_CUDA_DW_WINDOW(3, 3, 1, 1)
SPG_CUDA_DW_WINDOW(3, 3, 2, 2)
SPG_CUDA_DW_WINDOW(5, 5, 1, 1)
SPG_CUDA_DW_WINDOW(5, 5, 2, 2)
SPG_CUDA_DW_WINDOW(7, 7, 1, 1)
SPG_CUDA_DW_WINDOW(7, 7, 2, 2)

/* the matrix product in single precision (gemm.cu): every tile (BM, BN, BK, TM, TN), which is also the table
   of Spingalett.GpuKernels.c, for every operand mode the executor uses (A, B, VEC: A_CONV and B_CONV 2, or 3
   reading four channels at once; VEC 1 when the other operands read four values at once) */
SPG_CUDA_GEMM_TILE(128, 128, 16, 8, 8)
SPG_CUDA_GEMM_TILE(128, 64, 16, 8, 4)
SPG_CUDA_GEMM_TILE(64, 128, 16, 4, 8)
SPG_CUDA_GEMM_TILE(64, 64, 16, 4, 4)
SPG_CUDA_GEMM_TILE(128, 32, 16, 8, 4)
SPG_CUDA_GEMM_TILE(128, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 128, 16, 4, 4)
SPG_CUDA_GEMM_TILE(64, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 64, 16, 4, 4)
SPG_CUDA_GEMM_TILE(128, 16, 16, 4, 4)
SPG_CUDA_GEMM_TILE(64, 16, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(16, 64, 16, 4, 4)

SPG_CUDA_GEMM_MODES(0, 1, 1)        /* dense layers: forward */
SPG_CUDA_GEMM_MODES(0, 1, 0)
SPG_CUDA_GEMM_MODES(0, 0, 1)        /* data gradient */
SPG_CUDA_GEMM_MODES(0, 0, 0)
SPG_CUDA_GEMM_MODES(1, 0, 1)        /* weight gradient */
SPG_CUDA_GEMM_MODES(1, 0, 0)
SPG_CUDA_GEMM_MODES(3, 1, 1)        /* convolutions: forward (and data gradients of transposed ones) */
SPG_CUDA_GEMM_MODES(2, 1, 0)
SPG_CUDA_GEMM_MODES(3, 0, 1)        /* data gradient (and forward of transposed ones) */
SPG_CUDA_GEMM_MODES(2, 0, 0)
SPG_CUDA_GEMM_MODES(1, 3, 1)        /* weight gradient */
SPG_CUDA_GEMM_MODES(1, 2, 0)

/* units of the product built with GENERAL (every activation in the epilogue, the values before it with FLAG_PRE):
   dense layers' forward passes and data gradients, reading four values at once */
SPG_CUDA_GEMM_GENERAL(0, 1, 1)
SPG_CUDA_GEMM_GENERAL(0, 0, 1)

/* the matrix product on the matrix units (gemm_mma.cu): every tile (BM, BN, BK, TM, TN: warps of 16 TM x 16 TN
   outputs), which is also the table of Spingalett.GpuKernels.c, for the operand modes and the ways of reading
   them (A, B, KA, KB: 2 kept as bfloat16, eight values at once; 1 floats, four at once; 0 anything, one value
   at once) the executor uses: units gemm_mma_<BM>x<BN>x<BK>_<TM>x<TN>_a<A>b<B>_<ka><kb>, w f o for 2 1 0 */
SPG_CUDA_MMA_TILE(128, 128, 32, 2, 4)
SPG_CUDA_MMA_TILE(128, 64, 32, 4, 2)
SPG_CUDA_MMA_TILE(64, 64, 32, 2, 2)
SPG_CUDA_MMA_TILE(128, 32, 32, 2, 1)
SPG_CUDA_MMA_TILE(128, 16, 32, 2, 1)
SPG_CUDA_MMA_TILE(64, 32, 32, 2, 1)
SPG_CUDA_MMA_TILE(32, 64, 32, 1, 2)
SPG_CUDA_MMA_TILE(64, 16, 32, 2, 1)
SPG_CUDA_MMA_TILE(32, 32, 32, 1, 1)
SPG_CUDA_MMA_TILE(16, 64, 32, 1, 1)
SPG_CUDA_MMA_TILE(32, 16, 32, 1, 1)
SPG_CUDA_MMA_TILE(16, 32, 32, 1, 1)

SPG_CUDA_MMA_MODES(0, 1, 2, 1)      /* dense layers: forward (activations kept as bfloat16, weights as floats) */
SPG_CUDA_MMA_MODES(0, 1, 2, 2)      /* (the weights' bfloat16 copy) */
SPG_CUDA_MMA_MODES(0, 1, 0, 0)
SPG_CUDA_MMA_MODES(0, 0, 2, 1)      /* data gradient */
SPG_CUDA_MMA_MODES(0, 0, 2, 2)
SPG_CUDA_MMA_MODES(0, 0, 0, 0)
SPG_CUDA_MMA_MODES(1, 0, 2, 2)      /* weight gradient */
SPG_CUDA_MMA_MODES(1, 0, 0, 0)
SPG_CUDA_MMA_MODES(2, 1, 2, 1)      /* convolutions: forward */
SPG_CUDA_MMA_MODES(2, 1, 2, 2)
SPG_CUDA_MMA_MODES(2, 1, 0, 0)
SPG_CUDA_MMA_MODES(2, 0, 2, 1)      /* data gradient */
SPG_CUDA_MMA_MODES(2, 0, 2, 2)
SPG_CUDA_MMA_MODES(2, 0, 0, 0)
SPG_CUDA_MMA_MODES(1, 2, 2, 2)      /* weight gradient */
SPG_CUDA_MMA_MODES(1, 2, 0, 0)

/* units of the product on the matrix units built with GENERAL (every activation in the epilogue, the values
   before it with FLAG_PRE): dense layers' forward passes and data gradients, of activations kept as bfloat16 */
SPG_CUDA_MMA_GENERAL(0, 1, 2, 1)
SPG_CUDA_MMA_GENERAL(0, 1, 2, 2)
SPG_CUDA_MMA_GENERAL(0, 0, 2, 1)
SPG_CUDA_MMA_GENERAL(0, 0, 2, 2)

/* the large tiles on the matrix units (gemm_pipe.cu): BM x BN outputs over warps of 16 TM x 16 TN, steps of BK, STAGES
   of them in shared memory, which is also the table of Spingalett.GpuKernels.c, for the dense modes of operands kept
   as bfloat16, read eight values at once (A, B), and with GENERAL (_g) for those listed so: units
   gemm_pipe_<BM>x<BN>x<BK>_<TM>x<TN>_s<STAGES>_a<A>b<B> */
SPG_CUDA_PIPE_TILE(128, 128, 32, 4, 4, 3)
SPG_CUDA_PIPE_TILE(128, 64, 32, 4, 2, 3)
SPG_CUDA_PIPE_TILE(64, 128, 32, 2, 4, 3)
SPG_CUDA_PIPE_TILE(64, 64, 32, 2, 2, 4)
SPG_CUDA_PIPE_TILE(32, 64, 32, 1, 2, 4)        /* (few rows, as a short sequence's: weights streamed through four stages) */
SPG_CUDA_PIPE_TILE(64, 32, 32, 1, 2, 4)
SPG_CUDA_PIPE_TILE(16, 64, 32, 1, 2, 4)

SPG_CUDA_PIPE_MODES(0, 1)           /* forward */
SPG_CUDA_PIPE_MODES(0, 0)           /* data gradient */
SPG_CUDA_PIPE_MODES(1, 0)           /* weight gradient */
SPG_CUDA_PIPE_GENERAL(0, 1)
SPG_CUDA_PIPE_GENERAL(0, 0)
