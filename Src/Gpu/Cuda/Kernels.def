/* The units of PTX of the CUDA backend: SPG_CUDA_UNIT(name, source, "defines") is Src/Gpu/Cuda/<source>.cu
   compiled by cmake/Cuda.cmake with -DSPG_ENTRY=spg_<name> and the defines, a module of its own whose
   kernel is spg_<name>, given to the driver (and compiled by it) when first dispatched. The units of the
   matrix product are the tiles times the modes below: gemm_<BM>x<BN>x<BK>_<TM>x<TN>_a<A>b<B>, followed by v
   with VEC, compiled with -DGEMM=BM,BN,BK,TM,TN,A,B,VEC. */

SPG_CUDA_UNIT(reduce, reduce, "")
SPG_CUDA_UNIT(colsum, colsum, "")
SPG_CUDA_UNIT(bn, bn, "")
SPG_CUDA_UNIT(eltwise, eltwise, "")
SPG_CUDA_UNIT(output, output, "")
SPG_CUDA_UNIT(pool, pool, "")
SPG_CUDA_UNIT(combine, combine, "")
SPG_CUDA_UNIT(wtrans, wtrans, "")
SPG_CUDA_UNIT(optim, optim, "")
SPG_CUDA_UNIT(sumsq, sumsq, "")
SPG_CUDA_UNIT(upsample, upsample, "")
SPG_CUDA_UNIT(ln, ln, "")
SPG_CUDA_UNIT(rows, rows, "")

/* depthwise convolutions: any window and stride, and the common ones as constants */
SPG_CUDA_UNIT(dwconv, dwconv, "-DWINDOW=0,0,0,0")
SPG_CUDA_UNIT(dwconv_k33s11, dwconv, "-DWINDOW=3,3,1,1")
SPG_CUDA_UNIT(dwconv_k33s22, dwconv, "-DWINDOW=3,3,2,2")
SPG_CUDA_UNIT(dwconv_k55s11, dwconv, "-DWINDOW=5,5,1,1")
SPG_CUDA_UNIT(dwconv_k55s22, dwconv, "-DWINDOW=5,5,2,2")
SPG_CUDA_UNIT(dwconv_k77s11, dwconv, "-DWINDOW=7,7,1,1")
SPG_CUDA_UNIT(dwconv_k77s22, dwconv, "-DWINDOW=7,7,2,2")

/* the matrix product in single precision (gemm.cu): every tile (BM, BN, BK, TM, TN), which is also the table
   of Spingalett.GpuKernels.c, for every operand mode the executor uses (A, B, VEC: A_CONV and B_CONV 2, or 3
   reading four channels at once; VEC 1 when the other operands read four values at once) */
SPG_CUDA_GEMM_TILE(128, 128, 16, 8, 8)
SPG_CUDA_GEMM_TILE(128, 64, 16, 8, 4)
SPG_CUDA_GEMM_TILE(64, 128, 16, 4, 8)
SPG_CUDA_GEMM_TILE(64, 64, 16, 4, 4)
SPG_CUDA_GEMM_TILE(128, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 128, 16, 4, 4)
SPG_CUDA_GEMM_TILE(64, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 64, 16, 4, 4)
SPG_CUDA_GEMM_TILE(128, 16, 16, 4, 4)
SPG_CUDA_GEMM_TILE(64, 16, 16, 4, 4)
SPG_CUDA_GEMM_TILE(32, 32, 16, 4, 4)
SPG_CUDA_GEMM_TILE(16, 64, 16, 4, 4)

SPG_CUDA_GEMM_MODES(0, 1, 1)        /* dense layers: forward */
SPG_CUDA_GEMM_MODES(0, 1, 0)
SPG_CUDA_GEMM_MODES(0, 0, 1)        /* data gradient */
SPG_CUDA_GEMM_MODES(0, 0, 0)
SPG_CUDA_GEMM_MODES(1, 0, 1)        /* weight gradient */
SPG_CUDA_GEMM_MODES(1, 0, 0)
SPG_CUDA_GEMM_MODES(3, 1, 1)        /* convolutions: forward (and data gradients of transposed ones) */
SPG_CUDA_GEMM_MODES(2, 1, 0)
SPG_CUDA_GEMM_MODES(3, 0, 1)        /* data gradient (and forward of transposed ones) */
SPG_CUDA_GEMM_MODES(2, 0, 0)
SPG_CUDA_GEMM_MODES(1, 3, 1)        /* weight gradient */
SPG_CUDA_GEMM_MODES(1, 2, 0)
