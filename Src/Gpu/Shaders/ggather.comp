/* Gather of graphs (Spingalett.GpuGraph.c): y[o][j][e] = x[o][idx[j]][e], elements of SIZE bytes (1, 4 or 8), indices
   of 32 or 64 bits (WIDE; an index below 0 counts from the axis's end, one outside it gives zeros). As ggather.cu. */

#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#include "common.glsl"

layout(constant_id = 0) const uint SIZE = 4;
layout(constant_id = 1) const uint IDX = 3;          /* SPG_T_I32 (2) or SPG_T_I64 (3) */
layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 1) buffer B8 { uint8_t v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) buffer B64 { uvec2 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer I32 { int v[]; };

layout(push_constant) uniform Push {
    U32 y, x, idx;
    uint total, inner, count, axis;
} p;

void main() {
    const uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < p.total; i += stride) {
        uint e = i % p.inner, t = i / p.inner, j = t % p.count, o = t / p.count;
        /* (64-bit indices by their low word and sign: an axis has fewer than 2^31 values) */
        int k = IDX == 3u ? I32(p.idx).v[2u * j] : I32(p.idx).v[j];
        int hi = IDX == 3u ? I32(p.idx).v[2u * j + 1u] : (k < 0 ? -1 : 0);
        if (hi < -1 || hi > 0 || (hi == -1) != (k < 0)) k = -2147483647;
        if (k < 0) k += int(p.axis);
        bool inside = k >= 0 && uint(k) < p.axis;
        uint at = inside ? (o * p.axis + uint(k)) * p.inner + e : 0u;    /* (in range: lavapipe loads either way) */
        if (SIZE == 1u) B8(p.y).v[i] = inside ? B8(p.x).v[at] : uint8_t(0);
        else if (SIZE == 8u) B64(p.y).v[i] = inside ? B64(p.x).v[at] : uvec2(0u);
        else p.y.v[i] = inside ? p.x.v[at] : 0u;
    }
}
