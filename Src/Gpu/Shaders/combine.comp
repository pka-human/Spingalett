/*
 * The layers of graphs (Spingalett.Graph.c): additions, concatenations along the channels and
 * global average pooling, forward and backward. A sample is `cells` pixels; ck of the C channels of
 * y (or dy) starting at c0 belong to the input x (or dx).
 *
 *   ADD      y = x + b, or y = y + x without b (FLAG_ACCUMULATE); act(y) after the last input
 *   SLICE    forward: y[c0 .. c0 + ck) = act(x); backward: dx = (or +=) dy[c0 .. c0 + ck), times
 *            act'(b) (b: the input's activation outputs)
 *   GAP      forward: y[s][c] = act(mean over the cells of x[s][.][c]); backward: dx[s][p][c] = (or +=)
 *            dy[s][c] / cells, times act'(b)
 */

#version 460
#ifdef SPG_HALF
#extension GL_EXT_shader_16bit_storage : require
#endif
#include "common.glsl"

layout(constant_id = 0) const uint OP = 0;
layout(constant_id = 1) const uint ACT = ACT_NONE;
layout(constant_id = 2) const uint BACKWARD = 0;
layout(constant_id = 3) const uint HALF = 0;    /* words: x 0, y 1, b 2 (half.glsl) */
layout(local_size_x = 256) in;

#define ADD   0u
#define SLICE 1u
#define GAP   2u

#define FLAG_ACCUMULATE 1u
#define FLAG_LAST       2u      /* ADD: the last input, after which the activation applies */

layout(push_constant) uniform Push {
    F32 x, y, b;
    uint n, cells, C, c0, ck;
    uint flags;
} p;

#include "half.glsl"

void main() {
    const uint stride = gl_NumWorkGroups.x * 256u;
    const bool accumulate = (p.flags & FLAG_ACCUMULATE) != 0u;
    if (OP == ADD) {
        const uint total = p.n * p.cells * p.C;
        for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
            float v = accumulate ? ld(p.y, i, 1u) + ld(p.x, i, 0u) : ld(p.x, i, 0u) + ld(p.b, i, 2u);
            st(p.y, i, 1u, (p.flags & FLAG_LAST) != 0u ? activate(v, ACT) : v);
        }
    } else if (OP == SLICE) {
        const uint total = p.n * p.cells * p.ck;
        for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
            uint c = i % p.ck, q = i / p.ck, wide = q * p.C + p.c0 + c;
            if (BACKWARD == 0u) {
                st(p.y, wide, 1u, activate(ld(p.x, i, 0u), ACT));
            } else {
                float v = accumulate ? ld(p.x, i, 0u) + ld(p.y, wide, 1u) : ld(p.y, wide, 1u);
                st(p.x, i, 0u, ACT == ACT_NONE ? v : v * derivative(ld(p.b, i, 2u), ACT));
            }
        }
    } else if (BACKWARD == 0u) {
        const uint total = p.n * p.C;
        const float inv = 1.0 / float(p.cells);
        for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
            uint c = i % p.C, s = i / p.C, base = s * p.cells * p.C + c;
            float v = ld(p.x, base, 0u);
            for (uint q = 1u; q < p.cells; q++) v += ld(p.x, base + q * p.C, 0u);
            st(p.y, i, 1u, activate(v * inv, ACT));
        }
    } else {
        const uint total = p.n * p.cells * p.C;
        const float inv = 1.0 / float(p.cells);
        for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
            uint c = i % p.C, s = i / (p.cells * p.C);
            float g = ld(p.y, s * p.C + c, 1u) * inv;
            float v = accumulate ? ld(p.x, i, 0u) + g : g;
            st(p.x, i, 0u, ACT == ACT_NONE ? v : v * derivative(ld(p.b, i, 2u), ACT));
        }
    }
}
