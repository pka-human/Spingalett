/*
 * The output layer over rows of n outputs (one per sample):
 *
 *   SOFTMAX   y = softmax(y), as apply_softmax() computes it
 *   LOSS      loss[s] = the sample's loss (compute_sample_loss()) and delta = dL/dz of the output
 *             layer (output_delta() in Spingalett.Training.c), from targets t
 *   GRADS     delta = dL/dz from t = dL/dy of a loss of the caller's (output_delta_from_grad())
 *
 * The sparse cross-entropy (LOSS 2) has a row a cell of `cells` a sample, t a class index a cell (none
 * outside the n classes), and per sample sums in part, for R = samples x cells: [0, R) the cells'
 * losses, [R, 2R) whether each cell's largest output (the first of them) is its target, [2R, 2R +
 * samples) 1 / the sample's cells with targets (0 without any). COUNT (a thread a sample, rows the
 * samples) writes the last; LOSS (a row a cell, rows R) the first two and delta = (softmax(z) - the
 * smoothed target) / the count; SUM (a thread a sample) loss[s] = the mean of its cells' losses, as
 * spingalett_sparse_cross_entropy() computes it, and with ACCURACY loss[samples + s] the fraction
 * of its cells predicted.
 *
 * A thread takes a row; with WIDE (rows of many outputs, such as a segmentation's maps), a
 * workgroup does, thread j outputs j, j + 64, ... in order, and what the row sums or maximizes over
 * its outputs is combined across the threads in a fixed tree, so the results do not depend on
 * scheduling.
 */

#version 460
#include "common.glsl"

layout(constant_id = 0) const uint OP = 0;
layout(constant_id = 1) const uint ACT = ACT_NONE;     /* the output layer's activation */
layout(constant_id = 2) const uint LOSS = 0;    /* LossFunction */
layout(constant_id = 3) const uint WIDE = 0;    /* a workgroup a row */
layout(local_size_x = 64) in;

const uint STEP = WIDE != 0u ? 64u : 1u;        /* outputs between those of a thread */

#define SOFTMAX 0u
#define LOSS_OP 1u
#define GRADS   2u
#define COUNT   3u
#define SUM     4u

#define LOSS_MSE 0u
#define LOSS_CROSS_ENTROPY 1u
#define LOSS_SPARSE 2u

#define FLAG_ACCURACY 1u

layout(push_constant) uniform Push {
    F32 y, t, delta, loss, part;
    uint rows, n, cells;
    float smoothing;
    uint flags, pad;
} p;

shared float red[64];

/* WIDE: the sum (or the maximum) of every thread's v, in a fixed tree (uniform control flow). */
float combine(uint tid, float v, bool maximum) {
    if (WIDE == 0u) return v;
    red[tid] = v;
    barrier();
    for (uint h = 32u; h > 0u; h /= 2u) {
        if (tid < h) red[tid] = maximum ? max(red[tid], red[tid + h]) : red[tid] + red[tid + h];
        barrier();
    }
    const float r = red[0];
    barrier();                          /* read before the next combine() writes */
    return r;
}

bool has_target(float t) { return t >= 0.0 && t < float(p.n); }

void main() {
    const uint tid = WIDE != 0u ? gl_LocalInvocationID.x : 0u, n = p.n;
    const uint first = WIDE != 0u ? gl_WorkGroupID.x : gl_GlobalInvocationID.x;
    const uint stride = WIDE != 0u ? gl_NumWorkGroups.x : gl_NumWorkGroups.x * 64u;
    if (OP == COUNT || OP == SUM) {     /* the sparse cross-entropy's sums, a thread a sample */
        const uint R = p.rows * p.cells;
        for (uint s = gl_GlobalInvocationID.x; s < p.rows; s += gl_NumWorkGroups.x * 64u) {
            if (OP == COUNT) {
                uint count = 0u;
                for (uint c = 0u; c < p.cells; c++) count += has_target(p.t.v[s * p.cells + c]) ? 1u : 0u;
                p.part.v[2u * R + s] = count > 0u ? 1.0 / float(count) : 0.0;
                continue;
            }
            float loss = 0.0, hits = 0.0;
            for (uint c = 0u; c < p.cells; c++) {
                loss += p.part.v[s * p.cells + c];
                hits += p.part.v[R + s * p.cells + c];
            }
            const float inv = p.part.v[2u * R + s];
            p.loss.v[s] = loss * inv;
            if ((p.flags & FLAG_ACCURACY) != 0u) p.loss.v[p.rows + s] = hits * inv;
        }
        return;
    }
    for (uint s = first; s < p.rows; s += stride) {
        const uint base = s * n;
        if (OP == LOSS_OP && LOSS == LOSS_SPARSE) {
            /* a cell: the log of its softmax's sum, its loss against the smoothed target, its gradient */
            const uint R = p.rows;
            const float t = p.t.v[s], inv = p.part.v[2u * R + s / p.cells];
            const bool live = has_target(t);
            const uint target = live ? uint(t) : 0u;
            float top = -3.402823466e38, sum = 0.0, all = 0.0;
            for (uint k = tid; k < n; k += STEP) top = max(top, p.y.v[base + k]);
            top = combine(tid, top, true);
            float later = 0.0;          /* n - the first output of the largest value */
            for (uint k = tid; k < n; k += STEP) {
                const float z = p.y.v[base + k];
                sum += exp(z - top);
                all += z;
                if (z == top) later = max(later, float(n - k));
            }
            sum = combine(tid, sum, false);
            all = combine(tid, all, false);
            later = combine(tid, later, true);
            const float lse = top + log(sum), keep = 1.0 - p.smoothing, share = p.smoothing / float(n);
            for (uint k = tid; k < n; k += STEP) {
                float d = live ? (exp(p.y.v[base + k] - lse) - share) * inv : 0.0;
                if (live && k == target) d -= keep * inv;
                p.delta.v[base + k] = d;
            }
            if (tid == 0u) {
                const float loss = keep * (lse - p.y.v[base + target]) + (share > 0.0 ? share * (float(n) * lse - all) : 0.0);
                p.part.v[s] = live ? loss : 0.0;
                p.part.v[R + s] = live && uint(float(n) - later) == target ? 1.0 : 0.0;
            }
            continue;
        }
        if (OP == SOFTMAX) {
            float top = -3.402823466e38;
            for (uint k = tid; k < n; k += STEP) top = max(top, p.y.v[base + k]);
            top = combine(tid, top, true);
            float sum = 0.0;
            for (uint k = tid; k < n; k += STEP) {
                float e = exp(p.y.v[base + k] - top);
                p.y.v[base + k] = e;
                sum += e;
            }
            sum = combine(tid, sum, false);
            if (sum > 0.0) {
                float inv = 1.0 / sum;
                for (uint k = tid; k < n; k += STEP) p.y.v[base + k] *= inv;
            }
            continue;
        }

        if (OP == GRADS) {
            if (ACT == ACT_SOFTMAX) {
                float dot = 0.0;
                for (uint k = tid; k < n; k += STEP) dot += p.t.v[base + k] * p.y.v[base + k];
                dot = combine(tid, dot, false);
                for (uint k = tid; k < n; k += STEP) p.delta.v[base + k] = p.y.v[base + k] * (p.t.v[base + k] - dot);
            } else {
                for (uint k = tid; k < n; k += STEP)
                    p.delta.v[base + k] = p.t.v[base + k] * derivative(p.y.v[base + k], ACT);
            }
            continue;
        }

        const float eps = 1e-9;
        float loss = 0.0, dot = 0.0;
        for (uint k = tid; k < n; k += STEP) {
            float o = p.y.v[base + k], t = p.t.v[base + k];
            if (LOSS == LOSS_MSE) {
                float d = o - t;
                loss += d * d;
                dot += d * o;
            } else if (ACT == ACT_SIGMOID) {
                /* 1 - o bounded below (1 - 1e-9 is 1 in float): a saturated output gives no 0 log 0 */
                loss -= t * log(max(o, eps)) + (1.0 - t) * log(max(1.0 - o, eps));
            } else {
                loss -= t * log(max(o, eps));
            }
        }
        loss = combine(tid, loss, false);
        if (LOSS == LOSS_MSE && ACT == ACT_SOFTMAX) dot = combine(tid, dot, false);
        if (tid == 0u) p.loss.v[s] = loss;
        for (uint k = tid; k < n; k += STEP) {
            float o = p.y.v[base + k], d = o - p.t.v[base + k];
            if (LOSS == LOSS_MSE && ACT == ACT_SOFTMAX)
                d = o * (d - dot);
            else if (LOSS == LOSS_MSE || (ACT != ACT_SOFTMAX && ACT != ACT_SIGMOID))
                d *= derivative(o, ACT);    /* cross-entropy cancels the derivative of a softmax or sigmoid */
            p.delta.v[base + k] = d;
        }
    }
}
