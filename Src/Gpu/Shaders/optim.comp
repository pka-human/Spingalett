/*
 * One optimizer step over n parameters, element by element as Spingalett.SIMD.c updates them; the
 * learning rate and Adam's bias corrections come from the step header.
 */

#version 460
#include "common.glsl"

layout(constant_id = 0) const uint TYPE = 0;    /* OptimizerType */
layout(local_size_x = 256) in;

#define SGD      0u
#define MOMENTUM 1u
#define RMSPROP  2u
#define ADAM     3u
#define ADAMW    4u

layout(push_constant) uniform Push {
    F32 w, m, v, g;
    U32 header;
    uint n;
    float decay, momentum, beta1, beta2, epsilon;
} p;

void main() {
    const uint stride = gl_NumWorkGroups.x * 256u;
    const float lr = uintBitsToFloat(p.header.v[STEP_LR]);
    const float m_factor = uintBitsToFloat(p.header.v[STEP_M_FACTOR]), v_factor = uintBitsToFloat(p.header.v[STEP_V_FACTOR]);
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
        float w = p.w.v[i];
        if (TYPE == SGD) {
            w -= lr * (p.g.v[i] + p.decay * w);
        } else if (TYPE == MOMENTUM) {
            float m = p.momentum * p.m.v[i] + (p.g.v[i] + p.decay * w);
            p.m.v[i] = m;
            w -= lr * m;
        } else if (TYPE == RMSPROP) {
            float g = p.g.v[i] + p.decay * w;
            float v = p.beta2 * p.v.v[i] + (1.0 - p.beta2) * (g * g);
            p.v.v[i] = v;
            w -= lr * (g / (sqrt(v) + p.epsilon));
        } else {
            /* AdamW decays the weights directly; Adam adds the decay to the gradient */
            float g = p.g.v[i] + (TYPE == ADAM ? p.decay * w : 0.0);
            float m = p.beta1 * p.m.v[i] + (1.0 - p.beta1) * g;
            float v = p.beta2 * p.v.v[i] + (1.0 - p.beta2) * (g * g);
            p.m.v[i] = m;
            p.v.v[i] = v;
            float wd = TYPE == ADAMW ? 1.0 - lr * p.decay : 1.0;
            w = w * wd - lr * ((m * m_factor) / (sqrt(v * v_factor) + p.epsilon));
        }
        p.w.v[i] = w;
    }
}
