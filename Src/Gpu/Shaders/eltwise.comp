/*
 * Element-wise passes over `total` floats, rows of n (a sample's outputs, or a pixel's channels):
 *
 *   BIAS_ACT  y = act(y + a[column])            (a: optional, FLAG_A)
 *   DERIV     y = y act'(x)                     (x: the activation's outputs)
 *   MUL       y = y x
 *   ADD       y = y + x
 *   DROPOUT   rows of n units of one sample each: x = mask act'(y), then y = mask y, with the mask of
 *             spingalett_dropout_apply() (Spingalett.SIMD.c), drawn from the step header
 *   AFFINE    y = act(x a[c] + b[c])            (batch normalization)
 *   BDATA     y = (a[c] x + (a[C + c] b + a[2C + c])) act'(b)    (its data gradient; x = dy, b = input)
 *   SCALE     y = y a[0]                        (gradient clipping)
 *   AFFINE_ADD  y = act(z + (x a[c] + b[c]))   (a batch normalization added to z: residual blocks)
 *   COPY      y = x                             (the weights' bfloat16 copy)
 */

#version 460
#ifdef SPG_HALF
#extension GL_EXT_shader_16bit_storage : require
#endif
#include "common.glsl"

layout(constant_id = 0) const uint OP = 0;
layout(constant_id = 1) const uint ACT = 6;
layout(constant_id = 2) const uint HALF = 0;    /* words: y 0, x 1, a 2, b 3, z 8 (half.glsl) */
layout(local_size_x = 256) in;
#include "half.glsl"

#define BIAS_ACT 0u
#define DERIV    1u
#define MUL      2u
#define ADD      3u
#define DROPOUT  4u
#define AFFINE   5u
#define BDATA    6u
#define SCALE    7u
#define AFFINE_ADD 8u
#define COPY     9u

#define FLAG_A   1u

layout(push_constant) uniform Push {
    F32 y, x, a, b;
    U32 header;
    uint total, n;
    uint layer, threshold;
    float keep_scale;
    uint flags;
    F32 z;
} p;

uint hash32(uint x) {
    x ^= x >> 16; x *= 0x7FEB352Du;
    x ^= x >> 15; x *= 0x846CA68Bu;
    x ^= x >> 16;
    return x;
}

/* the mask's base for the sample at `position` of the step: the high word of
   mix64(seed ^ mix64(step * golden + (position << 20) + layer)) */
uint dropout_base(uint position) {
    uvec2 seed = uvec2(p.header.v[STEP_SEED_LO], p.header.v[STEP_SEED_HI]);
    uvec2 step = uvec2(p.header.v[STEP_STEP_LO], p.header.v[STEP_STEP_HI]);
    uvec2 v = add64(mul64(step, uvec2(0x7F4A7C15u, 0x9E3779B9u)), uvec2(position << 20, position >> 12));
    v = add64(v, uvec2(p.layer, 0u));
    return mix64(seed ^ mix64(v)).y;
}

void main() {
    const uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < p.total; i += stride) {
        if (OP == BIAS_ACT) {
            float v = ld(p.y, i, 0u);
            if ((p.flags & FLAG_A) != 0u) v += ld(p.a, i % p.n, 2u);
            st(p.y, i, 0u, activate(v, ACT));
        } else if (OP == DERIV) {
            st(p.y, i, 0u, ld(p.y, i, 0u) * derivative(ld(p.x, i, 1u), ACT));
        } else if (OP == MUL) {
            st(p.y, i, 0u, ld(p.y, i, 0u) * ld(p.x, i, 1u));
        } else if (OP == ADD) {
            st(p.y, i, 0u, ld(p.y, i, 0u) + ld(p.x, i, 1u));
        } else if (OP == DROPOUT) {
            uint s = i / p.n, j = i % p.n;
            uint base = dropout_base(p.header.v[STEP_POSITION] + s);
            float m = hash32(base + j * 0x9E3779B9u) >= p.threshold ? p.keep_scale : 0.0;
            float y = ld(p.y, i, 0u);
            st(p.x, i, 1u, m * derivative(y, ACT));
            st(p.y, i, 0u, y * m);
        } else if (OP == AFFINE) {
            uint c = i % p.n;
            st(p.y, i, 0u, activate(ld(p.x, i, 1u) * ld(p.a, c, 2u) + ld(p.b, c, 3u), ACT));
        } else if (OP == BDATA) {
            uint c = i % p.n;
            float xin = ld(p.b, i, 3u);
            float v = ld(p.a, c, 2u) * ld(p.x, i, 1u) + (ld(p.a, p.n + c, 2u) * xin + ld(p.a, 2u * p.n + c, 2u));
            st(p.y, i, 0u, ACT == ACT_NONE ? v : v * derivative(xin, ACT));
        } else if (OP == SCALE) {
            st(p.y, i, 0u, ld(p.y, i, 0u) * ld(p.a, 0u, 2u));
        } else if (OP == AFFINE_ADD) {
            uint c = i % p.n;
            st(p.y, i, 0u, activate(ld(p.z, i, 8u) + (ld(p.x, i, 1u) * ld(p.a, c, 2u) + ld(p.b, c, 3u)), ACT));
        } else if (OP == COPY) {
            st(p.y, i, 0u, ld(p.x, i, 1u));
        }
    }
}
