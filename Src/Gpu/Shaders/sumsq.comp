/*
 * Gradient norm clipping, in two passes of fixed order:
 *   PARTIAL  part[w] = the sum of squares of a and b (n_a and n_b floats, seen as one array) over
 *            slice w of 4096 elements (workgroups take slices w, w + workgroups, ...)
 *   CLIP     scalars[0] = max_norm / norm when the norm of all slices is finite and above max_norm,
 *            else 1 (one workgroup)
 */

#version 460
#include "common.glsl"

layout(constant_id = 0) const uint OP = 0;
layout(local_size_x = 256) in;

#define PARTIAL 0u
#define CLIP    1u
#define SLICE   4096u

layout(push_constant) uniform Push {
    F32 a, b, part, scalars;
    uint n_a, n_b, slices;
    float max_norm;
} p;

shared float s[256];

/* The sum of the 256 threads' t, in a fixed tree. */
float total(float t) {
    const uint tid = gl_LocalInvocationID.x;
    s[tid] = t;
    barrier();
    for (uint half_n = 128u; half_n > 0u; half_n /= 2u) {
        if (tid < half_n) s[tid] += s[tid + half_n];
        barrier();
    }
    float sum = s[0];
    barrier();                              /* before s is written again */
    return sum;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    if (OP == PARTIAL) {
        const uint n = p.n_a + p.n_b;
        for (uint w = gl_WorkGroupID.x; w < p.slices; w += gl_NumWorkGroups.x) {
            float t = 0.0;
            const uint i0 = w * SLICE;
            for (uint i = i0 + tid; i < min(n, i0 + SLICE); i += 256u) {
                float v = i < p.n_a ? p.a.v[i] : p.b.v[i - p.n_a];
                t = fma(v, v, t);
            }
            t = total(t);
            if (tid == 0u) p.part.v[w] = t;
        }
    } else {
        float t = 0.0;
        for (uint i = tid; i < p.slices; i += 256u) t += p.part.v[i];
        float norm = sqrt(total(t));
        if (tid == 0u) p.scalars.v[0] = (!isinf(norm) && !isnan(norm) && norm > p.max_norm) ? p.max_norm / norm : 1.0;
    }
}
