/*
 * C = A B over tiles of BM x BN outputs per workgroup, BK steps of the sum at a time through shared
 * memory, TM x TN outputs per thread, the next step's operands loaded into registers while the
 * current one is multiplied. The operands are read in place in the layouts the network keeps:
 *
 *   A_ROW    A(m, k) = a[m * lda + k]
 *   A_COL    A(m, k) = a[k * lda + m]                   (a transposed: dY^T of weight gradients)
 *   A_CONV   A(m, k) = the window of pixel m             (implicit im2col: of a convolution's input,
 *                                                         or of dY for its data gradient)
 *   B_ROW    B(k, n) = b[k * ldb + n]
 *   B_COL    B(k, n) = b[n * ldb + k]                   (weights [outputs x inputs])
 *   B_CONV   B(k, n) = the window of output pixel k      (weight gradients of convolutions)
 *
 * Every mode reads four consecutive values of its contiguous axis at once when VEC says so (bit 0
 * for A, bit 1 for B): k for A_ROW, A_CONV and B_COL, m for A_COL, n for B_ROW and B_CONV.
 * The host sets it when that axis and the strides are multiples of four and the addresses 16-byte
 * aligned (for the convolutions: channels a group multiples of four, so that four consecutive k
 * share a tap).
 *
 * Convolutions read their geometry and tap table from `geo` (spg_conv_geometry()): row m is pixel
 * (y, x) of a sample on an RH x RW grid, whose window starts at (y SH - PH, x SW - PW) of the gathered
 * GH x GW x GC tensor; tap k is (dh, dw, offset) from there, packed as dh | dw << 8 | offset << 16.
 * The data gradient of a convolution of stride s is s_h x s_w such products, one per phase (input
 * pixels (py + s_h y, px + s_w x)), each over the taps that reach it: with PHASED, row m is stored to
 * that pixel of a CH x CW grid.
 *
 * Workgroup z is group g times `slices` plus slice s, which sums k in [s * slice_k, (s + 1) * slice_k)
 * (split sums of weight gradients, stored as partial products and added in a fixed order by
 * reduce.comp).
 */

#version 460
#include "common.glsl"

layout(constant_id = 0) const uint BM = 128;
layout(constant_id = 1) const uint BN = 64;
layout(constant_id = 2) const uint BK = 16;
layout(constant_id = 3) const uint TM = 8;
layout(constant_id = 4) const uint TN = 4;
layout(constant_id = 5) const uint AMODE = 0;
layout(constant_id = 6) const uint BMODE = 0;
layout(constant_id = 7) const uint EPI = 0;
layout(constant_id = 8) const uint ACT = 6;
layout(constant_id = 9) const uint THREADS = 256;     /* (BM / TM) * (BN / TN) */
layout(constant_id = 10) const uint PHASED = 0;       /* rows are a phase of the C grid */
layout(constant_id = 11) const uint VEC = 0;
layout(local_size_x_id = 9) in;

#define A_ROW   0u
#define A_COL   1u
#define A_CONV  2u
#define B_ROW   0u
#define B_COL   1u
#define B_CONV  2u

#define EPI_STORE       0u      /* C = alpha AB + beta C */
#define EPI_BIAS_ACT    1u      /* C = act(AB + bias[column]) */
#define EPI_SCALE_ACT   2u      /* C = act(AB * scale[column] + shift[column]) */
#define EPI_PARTIAL     3u      /* partial[z] = AB */
#define EPI_DERIV       4u      /* C = (alpha AB + beta C) * act'(e0), e0 laid out like C */

#define FLAG_BIAS       1u

layout(push_constant) uniform Push {
    F32 a, b, c, e0, e1;
    U32 geo;
    uint M, N, K;
    uint lda, ldb, ldc;
    uint a_group, b_group, c_group;     /* added to a, b and c per group */
    uint slices, slice_k;
    float alpha, beta;
    uint flags;
} p;

/* geometry: rows over an RH x RW grid of pixels, gathered from a GH x GW x GC tensor */
#define GEO_RH 0u
#define GEO_RW 1u
#define GEO_GH 2u
#define GEO_GW 3u
#define GEO_GC 4u
#define GEO_SH 5u
#define GEO_SW 6u
#define GEO_PH 7u
#define GEO_PW 8u
#define GEO_CH 11u              /* PHASED: the grid C is laid out on, the phase's origin and steps */
#define GEO_CW 12u
#define GEO_CY 13u
#define GEO_CX 14u
#define GEO_CS 15u              /* step_h | step_w << 16 */
#define GEO_TAPS 16u

const bool VA = (VEC & 1u) != 0u, VB = (VEC & 2u) != 0u;
/* the axis a thread's loads run along: k (true) or the other one */
const bool A_KFAST = AMODE != A_COL, B_KFAST = BMODE == B_COL;
const uint WA = VA ? 4u : 1u, WB = VB ? 4u : 1u;            /* values per load */
const uint LA = (BM * BK / WA + THREADS - 1u) / THREADS;    /* loads per thread and step */
const uint LB = (BN * BK / WB + THREADS - 1u) / THREADS;
const uint SA = BM / 4u + 1u, SB = BN / 4u + 1u;            /* vec4 per shared row, padded */

shared vec4 As[BK * SA];
shared vec4 Bs[BK * SB];

uint tid, m0, n0, kend, aoff, boff;
uint RH, RW, GH, GW, GC, SH, SW, PH, PW;
int abase[LA], ah[LA], aw[LA];              /* A_CONV: each loaded row's sample and window */
int btap_h[LB], btap_w[LB], btap_c[LB];     /* B_CONV: each loaded column's tap, */
uint bsample[LB], by[LB], bx[LB];           /* and the output pixel (sample offset, y, x) of its k */
vec4 fa[LA], fb[LB];

/* the row (column) and k of the i-th load of A (B): the first of WA (WB) consecutive ones along the
   contiguous axis */
uint a_row(uint i) {
    uint e = tid + i * THREADS;
    return A_KFAST ? e / (BK / WA) : (e % (BM / WA)) * WA;
}
uint a_k(uint i) {
    uint e = tid + i * THREADS;
    return A_KFAST ? (e % (BK / WA)) * WA : e / (BM / WA);
}
uint b_col(uint i) {
    uint e = tid + i * THREADS;
    return B_KFAST ? e / (BK / WB) : (e % (BN / WB)) * WB;
}
uint b_k(uint i) {
    uint e = tid + i * THREADS;
    return B_KFAST ? (e % (BK / WB)) * WB : e / (BN / WB);
}
bool a_live(uint i) { return tid + i * THREADS < BM * BK / WA; }
bool b_live(uint i) { return tid + i * THREADS < BN * BK / WB; }

void prepare(uint kbeg) {
    if (AMODE == A_CONV || BMODE == B_CONV) {
        RH = p.geo.v[GEO_RH]; RW = p.geo.v[GEO_RW];
        GH = p.geo.v[GEO_GH]; GW = p.geo.v[GEO_GW]; GC = p.geo.v[GEO_GC];
        SH = p.geo.v[GEO_SH]; SW = p.geo.v[GEO_SW]; PH = p.geo.v[GEO_PH]; PW = p.geo.v[GEO_PW];
    }
    if (AMODE == A_CONV) {
        for (uint i = 0; i < LA; i++) {
            uint m = m0 + a_row(i);
            uint n = m / (RH * RW), r = m % (RH * RW), y = r / RW, x = r % RW;
            abase[i] = int(n * GH * GW * GC);
            ah[i] = int(y * SH) - int(PH);
            aw[i] = int(x * SW) - int(PW);
            if (m >= p.M || !a_live(i)) ah[i] = -(1 << 28);    /* never inside */
        }
    }
    if (BMODE == B_CONV) {
        for (uint i = 0; i < LB; i++) {
            uint n = n0 + b_col(i);
            uint t = n < p.N ? p.geo.v[GEO_TAPS + n] : 0u;
            btap_h[i] = int(t & 255u);
            btap_w[i] = n < p.N ? int((t >> 8) & 255u) : (1 << 28);
            btap_c[i] = int(t >> 16);
            /* k advances by BK a step: the pixel is followed rather than divided out every time */
            uint k = kbeg + b_k(i), r = k % (RH * RW);
            bsample[i] = (k / (RH * RW)) * GH * GW * GC;
            by[i] = r / RW;
            bx[i] = r % RW;
        }
    }
}

/* WA (or WB) consecutive floats from x at index at (a multiple of four with vectors) */
vec4 load(F32 x, uint at, bool vec) {
    if (vec) return F32x4(x).v[at >> 2];
    return vec4(x.v[at], 0.0, 0.0, 0.0);
}

void fetch(uint k0) {
    for (uint i = 0; i < LA; i++) {
        uint m = m0 + a_row(i), k = k0 + a_k(i);
        vec4 v = vec4(0.0);
        /* vectors need all four inside: m or k a multiple of four below a multiple-of-four bound */
        if (a_live(i) && m < p.M && k < kend) {
            if (AMODE == A_ROW) {
                v = load(p.a, aoff + m * p.lda + k, VA);
            } else if (AMODE == A_COL) {
                v = load(p.a, aoff + k * p.lda + m, VA);
            } else {
                uint t = p.geo.v[GEO_TAPS + k];
                int y = ah[i] + int(t & 255u), x = aw[i] + int((t >> 8) & 255u);
                if (uint(y) < GH && uint(x) < GW)
                    v = load(p.a, uint(abase[i]) + (uint(y) * GW + uint(x)) * GC + (t >> 16) + aoff, VA);
            }
        }
        fa[i] = v;
    }
    for (uint i = 0; i < LB; i++) {
        uint n = n0 + b_col(i), k = k0 + b_k(i);
        vec4 v = vec4(0.0);
        if (b_live(i) && n < p.N && k < kend) {
            if (BMODE == B_ROW) {
                v = load(p.b, boff + k * p.ldb + n, VB);
            } else if (BMODE == B_COL) {
                v = load(p.b, boff + n * p.ldb + k, VB);
            } else {
                /* k: an output pixel (sample, y, x) of the RH x RW grid; n: a tap of its window */
                int y = int(by[i] * SH) - int(PH) + btap_h[i], x = int(bx[i] * SW) - int(PW) + btap_w[i];
                if (uint(y) < GH && uint(x) < GW)
                    v = load(p.b, bsample[i] + (uint(y) * GW + uint(x)) * GC + uint(btap_c[i]) + boff, VB);
            }
        }
        fb[i] = v;
        if (BMODE == B_CONV) {
            bx[i] += BK;
            while (bx[i] >= RW) {
                bx[i] -= RW;
                if (++by[i] == RH) { by[i] = 0u; bsample[i] += GH * GW * GC; }
            }
        }
    }
}

/* shared element (k, m) of A, (k, n) of B */
void put_a(uint k, uint m, float v) { As[k * SA + (m >> 2)][m & 3u] = v; }
void put_b(uint k, uint n, float v) { Bs[k * SB + (n >> 2)][n & 3u] = v; }

void store_tiles() {
    for (uint i = 0; i < LA; i++) {
        if (!a_live(i)) continue;
        uint k = a_k(i), m = a_row(i);
        if (!VA) put_a(k, m, fa[i].x);
        else if (A_KFAST) { put_a(k, m, fa[i].x); put_a(k + 1u, m, fa[i].y); put_a(k + 2u, m, fa[i].z); put_a(k + 3u, m, fa[i].w); }
        else As[k * SA + (m >> 2)] = fa[i];
    }
    for (uint i = 0; i < LB; i++) {
        if (!b_live(i)) continue;
        uint k = b_k(i), n = b_col(i);
        if (!VB) put_b(k, n, fb[i].x);
        else if (B_KFAST) { put_b(k, n, fb[i].x); put_b(k + 1u, n, fb[i].y); put_b(k + 2u, n, fb[i].z); put_b(k + 3u, n, fb[i].w); }
        else Bs[k * SB + (n >> 2)] = fb[i];
    }
}

void main() {
    tid = gl_LocalInvocationID.x;
    const uint z = gl_WorkGroupID.z, g = z / p.slices, s = z % p.slices;
    m0 = gl_WorkGroupID.x * BM;
    n0 = gl_WorkGroupID.y * BN;
    const uint kbeg = s * p.slice_k;
    kend = min(p.K, kbeg + p.slice_k);
    aoff = g * p.a_group;
    boff = g * p.b_group;
    prepare(kbeg);

    /* thread (tr, tc) computes rows tr TM .. + TM and columns tc TN .. + TN of the tile */
    const uint tc = tid % (BN / TN), tr = tid / (BN / TN);
    vec4 acc[TM * TN / 4];          /* acc[i * TN / 4 + j]: row i, columns 4j .. 4j + 3 */
    for (uint i = 0; i < TM * TN / 4u; i++) acc[i] = vec4(0.0);

    if (kbeg < kend) fetch(kbeg);
    for (uint k0 = kbeg; k0 < kend; k0 += BK) {
        store_tiles();
        barrier();
        if (k0 + BK < kend) fetch(k0 + BK);
        for (uint kk = 0; kk < BK; kk++) {
            vec4 av[TM / 4], bv[TN / 4];
            for (uint i = 0; i < TM / 4u; i++) av[i] = As[kk * SA + tr * (TM / 4u) + i];
            for (uint j = 0; j < TN / 4u; j++) bv[j] = Bs[kk * SB + tc * (TN / 4u) + j];
            for (uint i = 0; i < TM; i++) {
                float a = av[i >> 2][i & 3u];
                for (uint j = 0; j < TN / 4u; j++) acc[i * (TN / 4u) + j] = fma(vec4(a), bv[j], acc[i * (TN / 4u) + j]);
            }
        }
        barrier();
    }

    const uint coff = g * p.c_group;
    uint CH, CW, CY, CX, CSH, CSW;
    if (PHASED != 0u) {
        CH = p.geo.v[GEO_CH]; CW = p.geo.v[GEO_CW]; CY = p.geo.v[GEO_CY]; CX = p.geo.v[GEO_CX];
        CSH = p.geo.v[GEO_CS] & 0xFFFFu; CSW = p.geo.v[GEO_CS] >> 16;
    }
    for (uint i = 0; i < TM; i++) {
        uint m = m0 + tr * TM + i;
        if (m >= p.M) break;
        uint row = m;               /* the row of C */
        if (PHASED != 0u) {
            uint n = m / (RH * RW), r = m % (RH * RW);
            row = (n * CH + CY + CSH * (r / RW)) * CW + CX + CSW * (r % RW);
        }
        for (uint j = 0; j < TN; j++) {
            uint n = n0 + tc * TN + j;
            if (n >= p.N) break;
            float v = acc[i * (TN / 4u) + (j >> 2)][j & 3u];
            if (EPI == EPI_PARTIAL) {
                p.c.v[(z * p.M + m) * p.N + n] = v;
                continue;
            }
            uint at = coff + row * p.ldc + n;
            if (EPI == EPI_STORE) {
                v *= p.alpha;
                if (p.beta != 0.0) v += p.beta * p.c.v[at];
            } else if (EPI == EPI_BIAS_ACT) {
                if ((p.flags & FLAG_BIAS) != 0u) v += p.e0.v[coff + n];
                v = activate(v, ACT);
            } else if (EPI == EPI_SCALE_ACT) {
                v = activate(v * p.e0.v[coff + n] + p.e1.v[coff + n], ACT);
            } else if (EPI == EPI_DERIV) {
                v *= p.alpha;
                if (p.beta != 0.0) v += p.beta * p.c.v[at];
                v *= derivative(p.e0.v[at], ACT);
            }
            p.c.v[at] = v;
        }
    }
}
