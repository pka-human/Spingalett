/*
 * C = A B over tiles of BM x BN outputs per workgroup, BK steps of the sum at a time through shared
 * memory, TM x TN outputs per thread, the next step's operands loaded into registers while the
 * current one is multiplied. The operands are read in place in the layouts the network keeps:
 *
 *   A_ROW    A(m, k) = a[m * lda + k]
 *   A_COL    A(m, k) = a[k * lda + m]                   (a transposed: dY^T of weight gradients)
 *   A_CONV   A(m, k) = the window of pixel m             (implicit im2col: of a convolution's input,
 *                                                         or of dY for its data gradient)
 *   B_ROW    B(k, n) = b[k * ldb + n]
 *   B_COL    B(k, n) = b[n * ldb + k]                   (weights [outputs x inputs])
 *   B_CONV   B(k, n) = the window of output pixel k      (weight gradients of convolutions)
 *
 * Every mode reads four consecutive values of its contiguous axis at once when VEC says so (bit 0
 * for A, bit 1 for B): k for A_ROW, A_CONV and B_COL, m for A_COL, n for B_ROW and B_CONV.
 * The host sets it when that axis and the strides are multiples of four and the addresses 16-byte
 * aligned (for the convolutions: channels a group multiples of four, so that four consecutive k
 * share a tap).
 *
 * Convolutions read their geometry and tap table from `geo` (spg_conv_geometry()): row m is pixel
 * (y, x) of a sample on an RH x RW grid, whose window starts at (y SH - PH, x SW - PW) of the gathered
 * GH x GW x GC tensor; tap k is (dh, dw, offset) from there, packed as dh | dw << 8 | offset << 16.
 * The data gradient of a convolution of stride s is s_h x s_w such products, one per phase (input
 * pixels (py + s_h y, px + s_w x)), each over the taps that reach it: with PHASED, row m is stored to
 * that pixel of a CH x CW grid.
 *
 * Workgroup z is group g times `slices` plus slice s, which sums k in [s * slice_k, (s + 1) * slice_k)
 * (split sums of weight gradients, stored as partial products and added in a fixed order by
 * reduce.comp).
 */

#version 460
#include "common.glsl"

layout(constant_id = 0) const uint BM = 128;
layout(constant_id = 1) const uint BN = 64;
layout(constant_id = 2) const uint BK = 16;
layout(constant_id = 3) const uint TM = 8;
layout(constant_id = 4) const uint TN = 4;
layout(constant_id = 5) const uint AMODE = 0;
layout(constant_id = 6) const uint BMODE = 0;
layout(constant_id = 7) const uint EPI = 0;
layout(constant_id = 8) const uint ACT = 6;
layout(constant_id = 9) const uint THREADS = 256;     /* (BM / TM) * (BN / TN) */
layout(constant_id = 10) const uint PHASED = 0;       /* rows are a phase of the C grid */
layout(constant_id = 11) const uint VEC = 0;
layout(local_size_x_id = 9) in;

#include "gemm_common.glsl"

const uint SA = BM / 4u + 1u, SB = BN / 4u + 1u;            /* vec4 per shared row, padded */

shared vec4 As[BK * SA];
shared vec4 Bs[BK * SB];

/* shared element (k, m) of A, (k, n) of B */
void put_a(uint k, uint m, float v) { As[k * SA + (m >> 2)][m & 3u] = v; }
void put_b(uint k, uint n, float v) { Bs[k * SB + (n >> 2)][n & 3u] = v; }

void store_tiles() {
    for (uint i = 0; i < LA; i++) {
        if (!a_live(i)) continue;
        uint k = a_k(i), m = a_row(i);
        if (!VA) put_a(k, m, fa[i].x);
        else if (A_KFAST) { put_a(k, m, fa[i].x); put_a(k + 1u, m, fa[i].y); put_a(k + 2u, m, fa[i].z); put_a(k + 3u, m, fa[i].w); }
        else As[k * SA + (m >> 2)] = fa[i];
    }
    for (uint i = 0; i < LB; i++) {
        if (!b_live(i)) continue;
        uint k = b_k(i), n = b_col(i);
        if (!VB) put_b(k, n, fb[i].x);
        else if (B_KFAST) { put_b(k, n, fb[i].x); put_b(k + 1u, n, fb[i].y); put_b(k + 2u, n, fb[i].z); put_b(k + 3u, n, fb[i].w); }
        else Bs[k * SB + (n >> 2)] = fb[i];
    }
}

void main() {
    tid = gl_LocalInvocationID.x;
    const uint z = gl_WorkGroupID.z, g = z / p.slices, s = z % p.slices;
    m0 = (p.m_tile0 + gl_WorkGroupID.x) * BM;
    n0 = gl_WorkGroupID.y * BN;
    const uint kbeg = s * p.slice_k;
    kend = min(p.K, kbeg + p.slice_k);
    aoff = g * p.a_group;
    boff = g * p.b_group;
    prepare(kbeg);

    /* thread (tr, tc) computes rows tr TM .. + TM and columns tc TN .. + TN of the tile */
    const uint tc = tid % (BN / TN), tr = tid / (BN / TN);
    vec4 acc[TM * TN / 4];          /* acc[i * TN / 4 + j]: row i, columns 4j .. 4j + 3 */
    for (uint i = 0; i < TM * TN / 4u; i++) acc[i] = vec4(0.0);

    if (kbeg < kend) fetch(kbeg);
    for (uint k0 = kbeg; k0 < kend; k0 += BK) {
        store_tiles();
        barrier();
        if (k0 + BK < kend) fetch(k0 + BK);
        for (uint kk = 0; kk < BK; kk++) {
            vec4 av[TM / 4], bv[TN / 4];
            for (uint i = 0; i < TM / 4u; i++) av[i] = As[kk * SA + tr * (TM / 4u) + i];
            for (uint j = 0; j < TN / 4u; j++) bv[j] = Bs[kk * SB + tc * (TN / 4u) + j];
            for (uint i = 0; i < TM; i++) {
                float a = av[i >> 2][i & 3u];
                for (uint j = 0; j < TN / 4u; j++) acc[i * (TN / 4u) + j] = fma(vec4(a), bv[j], acc[i * (TN / 4u) + j]);
            }
        }
        barrier();
    }

    const uint coff = g * p.c_group;
    for (uint i = 0; i < TM; i++) {
        uint m = m0 + tr * TM + i;
        if (m >= p.M) break;
        const uint row = c_row(m);
        for (uint j = 0; j < TN; j++) {
            uint n = n0 + tc * TN + j;
            if (n >= p.N) break;
            store_c(z, coff, m, row, n, acc[i * (TN / 4u) + (j >> 2)][j & 3u]);
        }
    }
}
