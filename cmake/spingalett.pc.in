prefix=${pcfiledir}/@SPINGALETT_PC_PREFIX@
exec_prefix=${prefix}
libdir=@SPINGALETT_PC_LIBDIR@
includedir=@SPINGALETT_PC_INCLUDEDIR@

Name: @SPINGALETT_PC_NAME@
Description: @SPINGALETT_PC_DESCRIPTION@
URL: https://github.com/pka-human/Spingalett
Version: @PROJECT_VERSION@
Libs: -L${libdir} -l@SPINGALETT_PC_LIBRARY@
Cflags: -I${includedir}
